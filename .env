# Copy to .env and customize before deploy
# cp .env.example .env

# Web UI port on host (default 80)
WEB_PORT=80

# API
PORT=8080
APP_ENV=production

# Postgres (used by the `db` service; api's DATABASE_URL is derived from these in docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=flood_evacuation

# Only needed for local (non-Docker) `go run ./cmd/api` — inside Docker, DATABASE_URL is set
# automatically by docker-compose.yml to point at the `db` service.
DATABASE_URL=postgres://postgres:password@localhost:5432/flood_evacuation?sslmode=disable

# Change these before going live
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password

# CORS: use * for demo, or your domain e.g. https://your-app.example.com
CORS_ORIGIN=*
