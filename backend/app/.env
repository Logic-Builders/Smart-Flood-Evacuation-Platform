PORT=8080
APP_ENV=development

# Points at the docker-compose `db` service, published to host loopback at 5432
DATABASE_URL=postgres://postgres:password@localhost:5432/flood_evacuation?sslmode=disable

JWT_SECRET=dev-secret-change-in-production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
CORS_ORIGIN=*

# Leave empty to keep flood zones manual-only (current behavior). Once set,
# the Google Flood Hub poller starts automatically and flood zones will be
# created/cleared by itself based on real gauge data. Get a key at
# https://console.cloud.google.com (enable the Flood Hub API).
GOOGLE_FLOOD_HUB_API_KEY=